{
  "name": "Finance & Accounting Management System Pro",
  "short_name": "Finance Pro",
  "version": "1.0.0",
  "description": "Integrated Financial Management & Accounting Information System",
  "tagline": "Smart Finance - Transparent Budgeting - Accurate Accounting",
  "type": "single-page-application",
  "modules": [
    "dashboard",
    "organization",
    "departments",
    "chart-of-accounts",
    "cash-bank",
    "budgets",
    "budget-realization",
    "income",
    "expenses",
    "transfers",
    "approvals",
    "journal",
    "general-ledger",
    "trial-balance",
    "reconciliation",
    "receivables",
    "payables",
    "assets",
    "tax",
    "financial-reports",
    "reports",
    "audit-trail",
    "settings",
    "ai-assistant"
  ],
  "roles": [
    "super_admin",
    "admin_org",
    "ketua",
    "direktur",
    "manager_finance",
    "staf_akuntansi",
    "bendahara",
    "kepala_departemen",
    "kepala_unit",
    "auditor",
    "pengguna_unit"
  ],
  "database_tables": 38,
  "edge_functions": 4,
  "default_currency": "IDR",
  "default_locale": "id-ID",
  "default_date_format": "DD-MM-YYYY",
  "bookkeeping_method": "double_entry",
  "primary_color": "#0b1f3a",
  "accent_color": "#13b8a6",
  "deployment_targets": {
    "frontend": "vercel",
    "backend": "supabase",
    "database": "supabase-postgresql",
    "storage": "supabase-storage",
    "auth": "supabase-auth",
    "functions": "supabase-edge-functions"
  },
  "ai_providers": ["gemini", "openai"],
  "features": {
    "multi_tenant": true,
    "rbac": true,
    "double_entry_accounting": true,
    "automatic_journal": true,
    "approval_workflow": true,
    "audit_trail": true,
    "ai_assistant": true,
    "export_csv": true,
    "export_pdf": true,
    "bank_reconciliation": true,
    "fixed_asset_depreciation": true,
    "tax_management": true,
    "budget_monitoring": true,
    "realtime": false,
    "offline_mode": true,
    "mobile_responsive": true
  },
  "test_status": "ready",
  "production_ready": true,
  "license": "MIT"
